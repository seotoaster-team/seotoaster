  "config": {
    "preferred-install": {
      "zendlib/zendlib": "source",
      "seosamba/ecommerce": "source",
      "seosamba/ecommerce-cart": "source",
      "seosamba/ecommerce-quote": "source",
      "seosamba/ecommerce-promo": "source",
      "seosamba/netcontent": "source",
      "seosamba/websiteidcard": "source",
      "seosamba/newslog": "source",
      "seosamba/socialposter": "source",
      "seosamba/webbuilder": "source",
      "seosamba/apps": "source",
      "seosamba/toastauth": "source",
      "seosamba/notifier": "source",
      "seosamba/invoicetopdf": "source",
      "seosamba/flatrateshipping": "source",
      "seosamba/dashboard": "source",
      "seosamba/freedashboardtheme": "source",
      "seosamba/toasterstats": "source",
      "seosamba/productonly": "source",
      "seosamba/delivery": "source",
      "seosamba/paypal": "source",
      "seosamba/emailsequence": "source",
      "seosamba/crm": "source",
      "seosamba/encodedapi": "source",
      "seosamba/encodedleads": "source",
      "seosamba/freetheme": "source",
      "*": "dist"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "rm -rf seotoaster_core/library/.git",
      "cp -a vendor/zendlib/zendlib/. seotoaster_core/library/",
      "rm -rf plugins/shopping/.git",
      "cp -a vendor/seosamba/ecommerce/. plugins/shopping",
      "rm -rf plugins/cart/.git",
      "cp -a vendor/seosamba/ecommerce-cart/. plugins/cart",
      "rm -rf plugins/quote/.git",
      "cp -a vendor/seosamba/ecommerce-quote/. plugins/quote",
      "rm -rf plugins/promo/.git",
      "cp -a vendor/seosamba/ecommerce-promo/. plugins/promo",
      "rm -rf plugins/netcontent/.git",
      "cp -a vendor/seosamba/netcontent/. plugins/netcontent",
      "rm -rf plugins/widcard/.git",
      "cp -a vendor/seosamba/websiteidcard/. plugins/widcard",
      "rm -rf plugins/newslog/.git",
      "cp -a vendor/seosamba/newslog/. plugins/newslog",
      "rm -rf plugins/socialposter/.git",
      "cp -a vendor/seosamba/socialposter/. plugins/socialposter",
      "rm -rf plugins/webbuilder/.git",
      "cp -a vendor/seosamba/webbuilder/. plugins/webbuilder",
      "rm -rf plugins/apps/.git",
      "cp -a vendor/seosamba/apps/. plugins/apps",
      "rm -rf plugins/toastauth/.git",
      "cp -a vendor/seosamba/toastauth/. plugins/toastauth",
      "rm -rf plugins/notifier/.git",
      "cp -a vendor/seosamba/notifier/. plugins/notifier",
      "rm -rf plugins/invoicetopdf/.git",
      "cp -a vendor/seosamba/invoicetopdf/. plugins/invoicetopdf",
      "rm -rf plugins/flatrateshipping/.git",
      "cp -a vendor/seosamba/flatrateshipping/. plugins/flatrateshipping",
      "rm -rf plugins/dashboard/.git",
      "cp -a vendor/seosamba/dashboard/. plugins/dashboard",
      "rm -rf plugins/dashboard/web/themes/dashboardtheme/.git",
      "cp -a vendor/seosamba/freedashboardtheme/. plugins/dashboard/web/themes/dashboardtheme",
      "rm -rf plugins/toasterstats/.git",
      "cp -a vendor/seosamba/toasterstats/. plugins/toasterstats",
      "rm -rf plugins/productonly/.git",
      "cp -a vendor/seosamba/productonly/. plugins/productonly",
      "rm -rf plugins/delivery/.git",
      "cp -a vendor/seosamba/delivery/. plugins/delivery",
      "rm -rf plugins/paypal/.git",
      "cp -a vendor/seosamba/paypal/. plugins/paypal",
      "rm -rf plugins/emailsequence/.git",
      "cp -a vendor/seosamba/emailsequence/. plugins/emailsequence",
      "rm -rf plugins/crm/.git",
      "cp -a vendor/seosamba/crm/. plugins/crm",
      "rm -rf plugins/api/.git",
      "cp -a vendor/seosamba/encodedapi/. plugins/api",
      "rm -rf plugins/leads/.git",
      "cp -a vendor/seosamba/encodedleads/. plugins/leads",
      "test -f system/coreinfo.php || (cp system/coreinfo.php.default system/coreinfo.php && mv _install install)",
      "test -f robots.txt || cp robots.txt.default robots.txt",
      "test -f favicon.ico || cp favicon.ico.default favicon.ico",
      "test -f manifest.json || cp manifest.json.default manifest.json",
      "test -f .htaccess || cp .htaccess.default .htaccess",
      "cp -a vendor/seosamba/freetheme/. themes/default",
      "rm -rf themes/default/.git"
    ],
    "post-update-cmd": [
      "rm -rf seotoaster_core/library/.git",
      "cp -a vendor/zendlib/zendlib/. seotoaster_core/library/",
      "rm -rf plugins/shopping/.git",
      "cp -a vendor/seosamba/ecommerce/. plugins/shopping",
      "rm -rf plugins/cart/.git",
      "cp -a vendor/seosamba/ecommerce-cart/. plugins/cart",
      "rm -rf plugins/quote/.git",
      "cp -a vendor/seosamba/ecommerce-quote/. plugins/quote",
      "rm -rf plugins/promo/.git",
      "cp -a vendor/seosamba/ecommerce-promo/. plugins/promo",
      "rm -rf plugins/netcontent/.git",
      "cp -a vendor/seosamba/netcontent/. plugins/netcontent",
      "rm -rf plugins/widcard/.git",
      "cp -a vendor/seosamba/websiteidcard/. plugins/widcard",
      "rm -rf plugins/newslog/.git",
      "cp -a vendor/seosamba/newslog/. plugins/newslog",
      "rm -rf plugins/socialposter/.git",
      "cp -a vendor/seosamba/socialposter/. plugins/socialposter",
      "rm -rf plugins/webbuilder/.git",
      "cp -a vendor/seosamba/webbuilder/. plugins/webbuilder",
      "rm -rf plugins/apps/.git",
      "cp -a vendor/seosamba/apps/. plugins/apps",
      "rm -rf plugins/toastauth/.git",
      "cp -a vendor/seosamba/toastauth/. plugins/toastauth",
      "rm -rf plugins/notifier/.git",
      "cp -a vendor/seosamba/notifier/. plugins/notifier",
      "rm -rf plugins/invoicetopdf/.git",
      "cp -a vendor/seosamba/invoicetopdf/. plugins/invoicetopdf",
      "rm -rf plugins/flatrateshipping/.git",
      "cp -a vendor/seosamba/flatrateshipping/. plugins/flatrateshipping",
      "rm -rf plugins/dashboard/.git",
      "cp -a vendor/seosamba/dashboard/. plugins/dashboard",
      "rm -rf plugins/dashboard/web/themes/dashboardtheme/.git",
      "cp -a vendor/seosamba/freedashboardtheme/. plugins/dashboard/web/themes/dashboardtheme",
      "rm -rf plugins/toasterstats/.git",
      "cp -a vendor/seosamba/toasterstats/. plugins/toasterstats",
      "rm -rf plugins/productonly/.git",
      "cp -a vendor/seosamba/productonly/. plugins/productonly",
      "rm -rf plugins/delivery/.git",
      "cp -a vendor/seosamba/delivery/. plugins/delivery",
      "rm -rf plugins/paypal/.git",
      "cp -a vendor/seosamba/paypal/. plugins/paypal",
      "rm -rf plugins/emailsequence/.git",
      "cp -a vendor/seosamba/emailsequence/. plugins/emailsequence",
      "rm -rf plugins/crm/.git",
      "cp -a vendor/seosamba/crm/. plugins/crm",
      "rm -rf plugins/api/.git",
      "cp -a vendor/seosamba/encodedapi/. plugins/api",
      "rm -rf plugins/leads/.git",
      "cp -a vendor/seosamba/encodedleads/. plugins/leads",
      "test -f system/coreinfo.php || (cp system/coreinfo.php.default system/coreinfo.php && mv _install install)",
      "test -f robots.txt || cp robots.txt.default robots.txt",
      "test -f favicon.ico || cp favicon.ico.default favicon.ico",
      "test -f manifest.json || cp manifest.json.default manifest.json",
      "test -f .htaccess || cp .htaccess.default .htaccess",
      "cp -a vendor/seosamba/freetheme/. themes/default",
      "rm -rf themes/default/.git"
    ]
  }
