    "ext-pdo_mysql": "*",
    "ext-xml": "*",
    "ext-gmp": "*",
    "ext-zip": "*",
    "ext-ioncube-loader": "*",
    "ext-mcrypt": "*",
    "zendlib/zendlib": "dev-feature/php8.2-composer",
    "seosamba/ecommerce": "dev-develop",
    "seosamba/ecommerce-cart": "dev-develop",
    "seosamba/ecommerce-quote": "dev-master",
    "seosamba/ecommerce-promo": "dev-master",
    "seosamba/netcontent": "dev-master",
    "seosamba/websiteidcard": "dev-master",
